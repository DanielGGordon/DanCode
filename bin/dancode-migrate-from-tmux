#!/usr/bin/env node
/**
 * dancode-migrate-from-tmux
 *
 * One-shot migration: convert any `dancode-*` tmux sessions on this machine
 * into the new on-disk shellhost format under `~/.dancode/`, then kill the
 * original tmux sessions. Idempotent — a second run finds nothing left and
 * exits cleanly.
 *
 * Output layout:
 *   ~/.dancode/terminals/<id>/meta.json
 *   ~/.dancode/terminals/<id>/scrollback.log
 *   ~/.dancode/projects/<slug>/layout.json (terminal id appended)
 *
 * Stale legacy files (pre-shellhost `~/.dancode/terminals/<id>.json` metadata)
 * are removed so the migration leaves a clean tree.
 */

import { execFile } from 'node:child_process';
import { promisify } from 'node:util';
import {
  existsSync,
  mkdirSync,
  readdirSync,
  readFileSync,
  renameSync,
  statSync,
  unlinkSync,
  writeFileSync,
} from 'node:fs';
import { join } from 'node:path';
import { homedir } from 'node:os';

const execFileAsync = promisify(execFile);

const SESSION_PREFIX = 'dancode-';

function dancodeHome() {
  return join(homedir(), '.dancode');
}

function terminalsDir() {
  return join(dancodeHome(), 'terminals');
}

function projectsDir() {
  return join(dancodeHome(), 'projects');
}

function layoutPath(slug) {
  return join(projectsDir(), slug, 'layout.json');
}

function termDir(id) {
  return join(terminalsDir(), id);
}

function metaPath(id) {
  return join(termDir(id), 'meta.json');
}

function scrollbackPath(id) {
  return join(termDir(id), 'scrollback.log');
}

/**
 * Parse a `dancode-<slug>-<id>` session name into its slug + id components.
 * Returns null if it doesn't match the expected shape (the prefix is
 * required; the body must contain at least one '-' separating slug from id).
 *
 * The id is the LAST '-'-separated chunk so a slug that itself contains '-'
 * still parses correctly (e.g. `dancode-my-project-abc123` → slug=my-project,
 * id=abc123). Migration source ids in the legacy backend look like uuids
 * (which themselves contain hyphens), so we take the LAST FIVE hyphen-
 * separated chunks as the id when the body has at least six chunks, falling
 * back to the last chunk for non-uuid ids (test fixtures like `f1-abc`).
 *
 * To keep this robust without bringing in a regex, we do the simple thing:
 * - strip the dancode- prefix
 * - if the remainder looks like `<slug>-<8>-<4>-<4>-<4>-<12>` (uuid v4 id),
 *   peel the last five chunks back as the id
 * - else, peel just the last chunk
 */
export function parseSessionName(name) {
  if (typeof name !== 'string' || !name.startsWith(SESSION_PREFIX)) return null;
  const body = name.slice(SESSION_PREFIX.length);
  const parts = body.split('-');
  if (parts.length < 2) return null;

  // UUID v4 has 5 hyphenated chunks of length [8,4,4,4,12].
  const last5 = parts.slice(-5);
  if (
    last5.length === 5 &&
    last5[0].length === 8 &&
    last5[1].length === 4 &&
    last5[2].length === 4 &&
    last5[3].length === 4 &&
    last5[4].length === 12 &&
    [...last5.join('')].every((c) => /[0-9a-f]/i.test(c))
  ) {
    return {
      projectSlug: parts.slice(0, -5).join('-'),
      terminalId: last5.join('-'),
    };
  }

  return {
    projectSlug: parts.slice(0, -1).join('-'),
    terminalId: parts[parts.length - 1],
  };
}

async function listDancodeSessions() {
  try {
    const { stdout } = await execFileAsync('tmux', [
      'list-sessions', '-F', '#{session_name}',
    ]);
    return stdout
      .split('\n')
      .map((s) => s.trim())
      .filter((s) => s.startsWith(SESSION_PREFIX));
  } catch {
    // tmux server isn't running or has no sessions.
    return [];
  }
}

async function capturePane(name) {
  try {
    const { stdout } = await execFileAsync('tmux', [
      'capture-pane', '-p', '-S', '-', '-t', name,
    ]);
    return stdout;
  } catch {
    return '';
  }
}

async function paneCwd(name) {
  try {
    const { stdout } = await execFileAsync('tmux', [
      'display', '-t', name, '-p', '#{pane_current_path}',
    ]);
    return stdout.trim() || null;
  } catch {
    return null;
  }
}

async function killSession(name) {
  try {
    await execFileAsync('tmux', ['kill-session', '-t', name]);
    return true;
  } catch {
    return false;
  }
}

function ensureDir(path) {
  if (!existsSync(path)) mkdirSync(path, { recursive: true });
}

function writeAtomic(targetPath, content) {
  const tmp = `${targetPath}.tmp.${process.pid}.${Math.random().toString(36).slice(2)}`;
  writeFileSync(tmp, content);
  renameSync(tmp, targetPath);
}

function defaultLayout() {
  return {
    terminals: [],
    openFiles: [],
    splits: { type: 'leaf', id: 'root' },
    focusedPane: 'root',
  };
}

function readOrInitLayout(slug) {
  const path = layoutPath(slug);
  if (!existsSync(path)) return defaultLayout();
  try {
    const parsed = JSON.parse(readFileSync(path, 'utf8'));
    if (!parsed || typeof parsed !== 'object') return defaultLayout();
    if (!Array.isArray(parsed.terminals)) parsed.terminals = [];
    if (!Array.isArray(parsed.openFiles)) parsed.openFiles = [];
    if (!parsed.splits) parsed.splits = { type: 'leaf', id: 'root' };
    if (!parsed.focusedPane) parsed.focusedPane = 'root';
    return parsed;
  } catch {
    return defaultLayout();
  }
}

function appendTerminalToLayout(slug, terminalEntry) {
  const layout = readOrInitLayout(slug);
  const already = layout.terminals.some((t) => t && t.id === terminalEntry.id);
  if (already) return false;
  layout.terminals.push(terminalEntry);
  ensureDir(join(projectsDir(), slug));
  writeAtomic(layoutPath(slug), JSON.stringify(layout, null, 2) + '\n');
  return true;
}

/**
 * Remove pre-shellhost legacy metadata files (`<id>.json` directly under
 * `terminals/`). The new format puts each terminal in its own subdirectory
 * with a `meta.json` inside. Returns the count removed.
 */
function removeStaleLegacyFiles() {
  const dir = terminalsDir();
  if (!existsSync(dir)) return 0;
  let entries;
  try {
    entries = readdirSync(dir, { withFileTypes: true });
  } catch {
    return 0;
  }
  let removed = 0;
  for (const entry of entries) {
    // A *.json file directly under terminals/ is legacy (or a UUID with extension).
    if (!entry.isFile()) continue;
    if (!entry.name.endsWith('.json')) continue;
    try {
      unlinkSync(join(dir, entry.name));
      removed++;
    } catch {
      // ignore
    }
  }
  return removed;
}

async function migrateOne(sessionName) {
  const parsed = parseSessionName(sessionName);
  if (!parsed) return { ok: false, reason: 'unparseable' };
  const { projectSlug, terminalId } = parsed;
  if (!projectSlug || !terminalId) return { ok: false, reason: 'unparseable' };

  const scrollback = await capturePane(sessionName);
  const cwd = (await paneCwd(sessionName)) || process.env.HOME || homedir();

  ensureDir(termDir(terminalId));

  // Scrollback file. Overwrite if it already exists so re-migrating gives the
  // same content (idempotent). Note: in normal flow, the same id won't be
  // seen twice because the tmux session is killed after a successful run.
  writeAtomic(scrollbackPath(terminalId), scrollback);

  const nowIso = new Date().toISOString();
  const meta = {
    id: terminalId,
    projectSlug,
    cwd,
    command: process.env.SHELL || '/bin/bash',
    createdAt: nowIso,
    lastActiveAt: nowIso,
  };
  writeAtomic(metaPath(terminalId), JSON.stringify(meta));

  const layoutEntry = {
    id: terminalId,
    cwd: meta.cwd,
    command: meta.command,
  };
  appendTerminalToLayout(projectSlug, layoutEntry);

  const killed = await killSession(sessionName);

  return { ok: true, projectSlug, terminalId, killed };
}

async function main() {
  // Make sure the base dirs exist even when there are zero sessions to
  // migrate; this keeps a sensible final state on idempotent re-runs.
  ensureDir(dancodeHome());
  ensureDir(terminalsDir());
  ensureDir(projectsDir());

  const sessions = await listDancodeSessions();
  const projects = new Set();
  let migrated = 0;
  let killed = 0;

  for (const session of sessions) {
    const result = await migrateOne(session);
    if (!result.ok) {
      process.stderr.write(`[migrate] skipping ${session}: ${result.reason}\n`);
      continue;
    }
    projects.add(result.projectSlug);
    migrated++;
    if (result.killed) killed++;
  }

  const removed = removeStaleLegacyFiles();

  process.stdout.write(
    `Migrated ${migrated} terminals across ${projects.size} projects. ` +
    `Killed ${killed} tmux sessions. ` +
    `Removed ${removed} stale legacy files.\n`,
  );
}

const isDirectInvocation = (() => {
  try {
    // Node ESM main detection.
    const url = new URL(`file://${process.argv[1]}`).href;
    return url === import.meta.url;
  } catch {
    return false;
  }
})();

if (isDirectInvocation) {
  main().catch((err) => {
    process.stderr.write(`[migrate] error: ${err && err.stack ? err.stack : err}\n`);
    process.exit(1);
  });
}
