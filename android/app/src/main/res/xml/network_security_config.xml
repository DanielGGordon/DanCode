<?xml version="1.0" encoding="utf-8"?>
<!--
Pins the self-signed cert generated by reverse-proxy/scripts/generate-cert.sh
to the bare IP 5.78.231.51 — Techloq filters new hostnames, so DanCode runs
without a domain.  The pin is the SHA-256 of the Subject Public Key Info
(SPKI) and is regenerated whenever the cert is regenerated via
`reverse-proxy/scripts/sync-pin.sh` (writes back into this file).

The base-config block forbids cleartext globally; the explicit domain-config
re-permits HTTP only for the legacy `5.78.231.51:3000` web-server URL so
manual smoke tests against the unencrypted backend keep working during
development.  Production traffic always goes via the pinned HTTPS endpoint
on `5.78.231.51:8443`.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">5.78.231.51</domain>
        <pin-set>
            <pin digest="SHA-256">gE5z1E5vnySIeXrq9EMjOxbKIT0M+GPtlqOPbaFNNnY=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="@raw/dancode_server" />
        </trust-anchors>
    </domain-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
