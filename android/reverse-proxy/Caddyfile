# DanCode reverse proxy / TLS terminator.
#
# Terminates TLS on https://5.78.231.51:8443 with the self-signed cert
# generated by reverse-proxy/scripts/generate-cert.sh.  Proxies all other
# paths to the existing dancode-server on http://127.0.0.1:3000 — so the
# legacy plain `http://5.78.231.51:3000` URL keeps working untouched and
# the web client is unaffected.
#
# Also exposes a static `/downloads/` route over the same origin so the
# phone browser can sideload the latest debug APK (acceptance criterion 5).
# Drop new APKs into /var/lib/dancode-apk/ via the make publish-apk task.

{
    # Don't try to auto-manage TLS — we ship a pinned self-signed cert
    # because Techloq filters new hostnames so we run without a domain.
    auto_https off
    admin off
}

# Bind to the bare IP so virtual-host matching doesn't require SNI.
https://5.78.231.51:8443 {
    tls /etc/caddy/dancode-server.crt /etc/caddy/dancode-server.key {
        # The cert was minted with SAN=IP:5.78.231.51; nothing else is valid.
        protocols tls1.2 tls1.3
    }

    encode gzip

    # Static APK download — `curl -O https://5.78.231.51:8443/downloads/dancode-android-debug.apk`
    # handle_path strips the /downloads prefix so files live directly under
    # /var/lib/dancode-apk/ (matching scripts/publish-apk.sh's DST_DIR).
    handle_path /downloads/* {
        root * /var/lib/dancode-apk
        file_server {
            browse
            index off
        }
    }

    # Everything else (REST + socket.io) flows to the existing backend
    # which still binds to plain HTTP on :3000.
    handle {
        reverse_proxy 127.0.0.1:3000 {
            header_up Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }
}
