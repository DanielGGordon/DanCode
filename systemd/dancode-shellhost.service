[Unit]
Description=DanCode shellhost (PTY-owning backend)
Documentation=https://github.com/DanielGGordon/DanCode

[Service]
Type=simple
Restart=on-failure
RestartSec=1
ExecStart=/usr/bin/env node /opt/dancode/shellhost/src/index.js
Environment=DANCODE_SHELLHOST_SOCKET=%h/.dancode/shellhost.sock
Environment=NODE_ENV=production
# %h expands to the user's home directory under `systemd --user`.

[Install]
WantedBy=default.target
