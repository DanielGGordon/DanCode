{
  "name": "dancode-shellhost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "src/index.js",
  "bin": {
    "dancode-shellhost": "bin/dancode-shellhost.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "DANCODE_SHELLHOST_SOCKET=${DANCODE_SHELLHOST_SOCKET:-/tmp/dancode-shellhost-dev.sock} node --watch src/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "vitest": "^3.1.1"
  }
}
